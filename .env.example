# Slack Incoming Webhook URL — get this from your Slack workspace (see APP_SETUP.md)
SLACK_WEBHOOK_URL=your-slack-incoming-webhook-url-here

# Cron schedule (default: every Monday at 9:00 AM)
# Use https://crontab.guru to build a custom schedule
CRON_SCHEDULE=0 9 * * 1

# CAT pricing tool integration — fill in once access is confirmed
CAT_API_URL=
CAT_API_KEY=
